OPENAI_API_KEY=
GEMINI_API_KEY=
RAPIDFIRE_API_KEY=

# LLM provider preference order (comma separated):
# rapidfire,gemini,openai
LLM_PROVIDER_ORDER=gemini,openai
RAPIDFIRE_BASE_URL=
RAPIDFIRE_MODEL=rapidfire-default
GEMINI_MODEL=gemini-3-flash-preview

# Retrieval and vector search
PG_DSN=postgresql://user:password@localhost:5432/echopath
# Embeddings:
# provider: auto | openai | gemini
EMBEDDING_PROVIDER=auto
# OpenAI model example: text-embedding-3-small
# Gemini model example: gemini-embedding-001
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=8

# Data scripts
CENSUS_API_KEY=
